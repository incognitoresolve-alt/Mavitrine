# Seule variable requise : clé API YouTube Data v3
# (console.cloud.google.com > APIs & Services > Identifiants)
YOUTUBE_API_KEY=

# Optionnel : ne renseigner que si vous changez de chaîne YouTube.
# Par défaut, l'ID de chaîne et l'URL publique sont codés en dur dans
# src/lib/config.ts (ce ne sont pas des secrets, ils sont visibles par
# n'importe qui sur YouTube).
# YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@votre-chaine
