# Clé API YouTube Data v3 (console.cloud.google.com > APIs & Services > Identifiants)
YOUTUBE_API_KEY=

# ID de votre chaîne YouTube (commence par "UC...", visible dans les paramètres
# avancés de la chaîne ou via https://www.youtube.com/account_advanced)
YOUTUBE_CHANNEL_ID=

# URL publique de votre chaîne, utilisée pour le bouton "S'abonner"
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@votre-chaine
