{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mavitrine",
  "main": ".open-next/worker.js",
  // Exécuté automatiquement par `wrangler deploy` / `wrangler dev` avant le
  // bundling : garantit que .open-next/ existe même si la "Build command"
  // configurée côté dashboard Cloudflare (Workers Builds) est restée sur la
  // valeur par défaut `npm run build` (next build seul, sans .open-next/).
  "build": {
    "command": "npm run cf:build"
  },
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
  // Seule variable requise : la clé API YouTube, en secret (jamais commitée) :
  //   npx wrangler secret put YOUTUBE_API_KEY
  // L'ID de chaîne et l'URL publique sont codés en dur dans src/lib/config.ts
  // (non sensibles), donc rien d'autre à configurer ici.
}
